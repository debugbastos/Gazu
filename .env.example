# ===== GAZU — variáveis de ambiente =====
# Valores FICTÍCIOS. Copie para .env e preencha no servidor. NUNCA commite o .env real nem cole chaves em chats,
# tickets ou e-mails. Chaves privadas (tokens, secrets) ficam só no servidor — nunca no navegador.

NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Endereço público (https em produção). Usado em links de e-mail, webhooks, OAuth e SEO.
APP_URL=http://localhost:3000
DATABASE_PATH=data/gazu.db
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-48-bytes
SESSION_TTL_DAYS=30
# Atrás de proxy reverso confiável (Nginx, Cloudflare, Render...), use 1 para ler X-Forwarded-For
TRUST_PROXY=0

# Exibe avisos de demonstração e permite provedores simulados (somente fora de produção)
DEMO_MODE=true

# ---- Login com Google (OAuth 2.0) — vazio = botão desativado ----
# Redirect URI autorizado no Google Cloud: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Pagamentos (Mercado Pago) ----
# mercadopago | demo (somente desenvolvimento; bloqueado em produção) | none
PAYMENT_PROVIDER=demo
# Aceita também os nomes MERCADOPAGO_ACCESS_TOKEN, MERCADOPAGO_PUBLIC_KEY e MERCADOPAGO_WEBHOOK_SECRET.
# Access Token: PRIVADO (servidor). Public Key: pública (usada pelo SDK oficial no navegador para tokenizar o cartão).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# "Assinatura secreta" das notificações (Suas integrações › Webhooks). Webhook: {APP_URL}/api/webhooks/mercadopago
MP_WEBHOOK_SECRET=
# Métodos habilitados NA SUA CONTA: pix, credit_card, boleto (separados por vírgula)
MP_ENABLED_METHODS=pix,credit_card
# Parcelas máximas oferecidas (1–12). Juros/parcelas sem juros seguem a configuração da sua conta MP.
MP_MAX_INSTALLMENTS=1
PIX_EXPIRATION_MINUTES=30
BOLETO_DAYS=3
# Tempo para pagar antes de o pedido expirar e o estoque reservado voltar
ORDER_PAYMENT_WINDOW_MINUTES=60

# ---- Frete ----
# manual = regras do painel (/admin/frete) | melhorenvio = cotação e etiquetas reais | demo = simulação (dev)
SHIPPING_PROVIDER=demo
# CEP de origem (remetente) — obrigatório para Melhor Envio
SHIPPING_ORIGIN_CEP=
# Token do Melhor Envio (Configurações › Permissões de acesso › Gerar token). PRIVADO.
MELHORENVIO_TOKEN=
# sandbox | production (sandbox não gera etiqueta válida para postagem)
MELHORENVIO_ENV=sandbox
# Exigido pela API do Melhor Envio: "Nome da aplicação (e-mail de contato técnico)"
MELHORENVIO_USER_AGENT=GAZU Store (contato@seudominio.com.br)
# IDs dos serviços aceitos (vazio = todos os retornados). Ex.: 1,2 (PAC, SEDEX)
MELHORENVIO_SERVICES=
# Embalagem padrão quando o produto não tem medidas: comprimento x largura x altura (cm) x peso (g)
PACKAGE_DEFAULT=30x20x10x500

# ---- E-mail transacional ----
# console = só registra (não envia) | resend = envia pela API da Resend (domínio verificado)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=GAZU <nao-responda@seudominio.com.br>

# ---- WhatsApp Business (Cloud API oficial da Meta) — opcional ----
# Sem estas variáveis, o site usa apenas o link wa.me (abre o app; não há atendimento automatizado).
# Webhook: {APP_URL}/api/webhooks/whatsapp (verificação GET com hub.verify_token; POST com X-Hub-Signature-256)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ---- Monitoramento e alertas ----
# Alertas de erros críticos e divergências (e-mail requer EMAIL_PROVIDER=resend)
ALERT_EMAIL=
# Webhook (Slack, Discord, Teams ou similar) que recebe JSON { text } — opcional
ALERT_WEBHOOK_URL=

# ---- Backups do banco (SQLite) ----
BACKUP_DIR=backups
# Intervalo da rotina automática (0 = desligado)
BACKUP_INTERVAL_HOURS=24
# Quantos backups manter no disco
BACKUP_RETENTION=14

# ---- Rotinas periódicas ----
# true em UMA instância apenas (expiração de pedidos, reconciliação, e-mails, rastreio, backups, limpeza)
JOBS_ENABLED=true
