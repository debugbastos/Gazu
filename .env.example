# ===== GAZU — variáveis de ambiente (valores FICTÍCIOS; nunca commite o .env real) =====
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
DATABASE_PATH=data/gazu.db
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-48-bytes
SESSION_TTL_DAYS=30

# Exibe avisos de demonstração (produtos/preços/estoques ilustrativos)
DEMO_MODE=true

# ---- Login com Google (OAuth 2.0) — deixe vazio para desativar o botão ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Pagamentos ----
# mercadopago | demo (somente desenvolvimento; bloqueado em produção) | none
PAYMENT_PROVIDER=demo
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# Métodos habilitados NA SUA CONTA do Mercado Pago (pix,credit_card)
MP_ENABLED_METHODS=pix,credit_card
MP_MAX_INSTALLMENTS=1
PIX_EXPIRATION_MINUTES=30
ORDER_PAYMENT_WINDOW_MINUTES=60

# ---- Frete ----
# manual = regras definidas no painel (/admin/frete) | demo = simulação (somente desenvolvimento)
SHIPPING_PROVIDER=demo

# ---- E-mail transacional ----
# console = registra no terminal (desenvolvimento) | resend = envia via API Resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=GAZU <nao-responda@seudominio.com.br>

# Atrás de proxy reverso confiável (Nginx, Cloudflare, Render...), use 1 para ler X-Forwarded-For
TRUST_PROXY=0
