{
  "name": "gazu-store",
  "version": "0.1.0",
  "private": true,
  "description": "GAZU — loja virtual de moda (React + TypeScript + Node + SQLite)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "db:migrate": "node --disable-warning=ExperimentalWarning --import tsx src/server/cli/migrate.ts",
    "db:seed": "node --disable-warning=ExperimentalWarning --import tsx src/server/cli/seed.ts",
    "admin:create": "node --disable-warning=ExperimentalWarning --import tsx src/server/cli/create-admin.ts",
    "images": "node scripts/process-images.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:visual": "node tests/e2e/visual.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build:html": "node scripts/build-standalone.mjs && node -e \"require('fs').mkdirSync('site',{recursive:true});require('fs').copyFileSync('dist/index.html','site/index.html')\"",
    "test:html": "node tests/e2e/standalone.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.28.2",
    "playwright": "1.56.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
